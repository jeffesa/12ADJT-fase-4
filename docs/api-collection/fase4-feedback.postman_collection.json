        {
          "name": "Listar Avaliações",
          "item": [
            {
              "name": "listFeedbacks - Query all feedbacks",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 200\", () => pm.expect(pm.response.code).to.equal(200));",
                      "const response = pm.response.json();",
                      "pm.test(\"Has data field\", () => pm.expect(response).to.have.property(\"data\"));",
                      "pm.test(\"data has listFeedbacks field\", () => pm.expect(response.data).to.have.property(\"listFeedbacks\"));",
                      "const feedbacks = response.data.listFeedbacks;",
                      "pm.test(\"listFeedbacks is an array\", () => pm.expect(feedbacks).to.be.an(\"array\"));",
                      "if (feedbacks.length > 0) {",
                      "  pm.test(\"each item has id field\", () => pm.expect(feedbacks[0]).to.have.property(\"id\"));",
                      "  pm.test(\"each item has description field\", () => pm.expect(feedbacks[0]).to.have.property(\"description\"));",
                      "  pm.test(\"each item has rating field\", () => pm.expect(feedbacks[0]).to.have.property(\"rating\"));",
                      "  pm.test(\"each item has urgency field\", () => pm.expect(feedbacks[0]).to.have.property(\"urgency\"));",
                      "  pm.test(\"each item has createdAt field\", () => pm.expect(feedbacks[0]).to.have.property(\"createdAt\"));",
                      "  pm.test(\"id is valid UUID\", () => pm.expect(feedbacks[0].id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                      "  pm.test(\"urgency is HIGH, MEDIUM, or LOW\", () => pm.expect([\"HIGH\", \"MEDIUM\", \"LOW\"]).to.include(feedbacks[0].urgency));",
                      "  pm.test(\"createdAt is ISO 8601\", () => pm.expect(feedbacks[0].createdAt).to.match(/^\\d{4}-\\d{2}-\\d{2}T/));",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{localToken}}"
                  }
                ],
