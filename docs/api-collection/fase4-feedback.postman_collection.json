            {
              "name": "✅ 201 — nota 1 (urgência HIGH)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 201', () => pm.expect(pm.response.code).to.equal(201));",
                      "const b = pm.response.json();",
                      "pm.test('tem receiveFeedback', () => pm.expect(b).to.have.property('receiveFeedback'));",
                      "const feedback = b.receiveFeedback;",
                      "pm.test('id é UUID', () => pm.expect(feedback.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                      "pm.test('nota é 1', () => pm.expect(feedback.nota).to.equal(1));",
                      "pm.test('urgencia é HIGH', () => pm.expect(feedback.urgencia).to.equal('HIGH'));",
                      "pm.test('dataCriacao é ISO 8601', () => pm.expect(feedback.dataCriacao).to.match(/^\\d{4}-\\d{2}-\\d{2}T/));",
                      "pm.collectionVariables.set('feedbackId', feedback.id);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
