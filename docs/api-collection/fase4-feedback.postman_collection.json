              "name": "\u2705 201 \u2014 nota 1 (urg\u00eancia HIGH)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 201', () => pm.expect(pm.response.code).to.equal(201));",
                      "const b = pm.response.json();",
                      "pm.test('tem receiveFeedback', () => pm.expect(b).to.have.property('receiveFeedback'));",
                      "const feedback = b.receiveFeedback;",
                      "pm.test('id \u00e9 UUID', () => pm.expect(feedback.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                      "pm.test('nota \u00e9 1', () => pm.expect(feedback.nota).to.equal(1));",
                      "pm.test('urgencia \u00e9 HIGH', () => pm.expect(feedback.urgencia).to.equal('HIGH'));",
                      "pm.test('dataCriacao \u00e9 ISO 8601', () => pm.expect(feedback.dataCriacao).to.match(/^\\d{4}-\\d{2}-\\d{2}T/));",
                      "pm.collectionVariables.set('feedbackId', feedback.id);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
