meta {
  name: POST /feedback - nota 6 (MEDIUM urgência)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/feedback
  body: json {
    {
      "descricao": "Feedback moderado - teste",
      "nota": 6
    }
  }
  auth: none
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Urgência is MEDIUM", function() {
    const body = res.getBody();
    expect(body.receiveFeedback.urgencia).to.equal("MEDIUM");
  });
  test("Nota is 6", function() {
    const body = res.getBody();
    expect(body.receiveFeedback.nota).to.equal(6);
  });
}
