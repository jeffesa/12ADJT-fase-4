meta {
  name: GET /feedback - List all
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/feedback
  auth: none
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response has avaliacoes array", function() {
    const body = res.getBody();
    expect(body).to.have.property("avaliacoes");
    expect(body.avaliacoes).to.be.an("array");
  });
  test("Response has total count", function() {
    const body = res.getBody();
    expect(body).to.have.property("total");
    expect(body.total).to.be.a("number");
  });
}
