meta {
  name: POST /feedback - nota 1 (HIGH urgência)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/feedback
  body: json {
    {
      "descricao": "Feedback crítico - teste",
      "nota": 1
    }
  }
  auth: none
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response has receiveFeedback", function() {
    expect(res.getBody()).to.have.property("receiveFeedback");
  });
  test("Urgência is HIGH", function() {
    const body = res.getBody();
    expect(body.receiveFeedback.urgencia).to.equal("HIGH");
  });
  test("Nota is 1", function() {
    const body = res.getBody();
    expect(body.receiveFeedback.nota).to.equal(1);
  });
}
