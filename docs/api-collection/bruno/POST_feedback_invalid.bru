meta {
  name: POST /feedback - nota -1 (INVALID)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/feedback
  body: json {
    {
      "descricao": "Feedback inválido",
      "nota": -1
    }
  }
  auth: none
}

tests {
  test("Status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Response has status 400", function() {
    const body = res.getBody();
    expect(body.status).to.equal(400);
  });
  test("Response has detail", function() {
    const body = res.getBody();
    expect(body).to.have.property("detail");
  });
}
