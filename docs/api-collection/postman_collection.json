                "query": "mutation {\n  receiveFeedback(input: {\n    descricao: \"Okay service overall\"\n    nota: 6\n  }) {\n    id\n    descricao\n    nota\n    urgencia\n    dataCriacao\n  }\n}",
                "variables": {}
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Creates a feedback with MEDIUM urgency (rating 6-7 range). Rating 6 will be classified as MEDIUM urgency."
          }
        },
        {
          "name": "Create LOW Urgency Feedback (Rating 9)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  receiveFeedback(input: {\n    descricao: \"Excellent service quality\"\n    nota: 9\n  }) {\n    id\n    descricao\n    nota\n    urgencia\n    dataCriacao\n  }\n}",
                "variables": {}
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Creates a feedback with LOW urgency (rating 8-10 range). Rating 9 will be classified as LOW urgency."
          }
        }
      ]
    },
    {
      "name": "Queries",
      "description": "GraphQL queries for retrieving feedback",
      "item": [
        {
          "name": "List All Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  listarAvaliacoes {\n    id\n    descricao\n    nota\n    urgencia\n    dataCriacao\n  }\n}",
                "variables": {}
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Retrieves all feedback entries from the system. Returns a list of feedback objects with their complete details."
          }
        }
      ]
    },
