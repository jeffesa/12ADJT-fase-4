{
  "info": {
    "name": "Receive Feedback GraphQL API",
    "description": "Collection for testing the Receive Feedback GraphQL API with mutations and queries for feedback management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Mutations",
      "description": "GraphQL mutations for creating feedback",
      "item": [
        {
          "name": "Create HIGH Urgency Feedback (Rating 4)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  receiveFeedback(input: {\n    descricao: \"Bad experience with the service\"\n    nota: 4\n  }) {\n    id\n    descricao\n    nota\n    urgencia\n    dataCriacao\n  }\n}",
                "variables": {}
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Creates a feedback with HIGH urgency (rating 0-5 range). Rating 4 will be classified as HIGH urgency."
          }
        },
        {
          "name": "Create MEDIUM Urgency Feedback (Rating 6)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
