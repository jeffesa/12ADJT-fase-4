meta {
  name: Listar avaliações com chave (200)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "query": "query { listarAvaliacoes { id descricao nota urgencia dataCriacao } }"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Somente leitura, mas exige apiKey válida do ambiente.
}
