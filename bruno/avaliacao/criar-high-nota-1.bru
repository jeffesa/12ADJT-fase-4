meta {
  name: Criar avaliação HIGH - nota 1 (201)
  type: http
  seq: 4
  tags: [
    high-sns
  ]
}

post {
  url: {{baseUrl}}/avaliacao
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "descricao": "Feedback crítico via Bruno",
    "nota": 1
  }
}

assert {
  res.status: eq 201
}

tests {
  test("status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ATENÇÃO: nota de 0 a 5 é urgência HIGH e dispara publicação no SNS, que pode enviar email.
  NÃO execute em prod sem intenção. Cria registro real.
  Para pular ao rodar a collection no CLI: bru run --exclude-tags=high-sns
}
